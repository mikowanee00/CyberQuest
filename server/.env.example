# ------------------------------------------------------------------
# CyberQuest server settings
# Copy this file to ".env" (same folder) and change the values.
# The real .env file is ignored by Git so your secrets stay private.
# ------------------------------------------------------------------

# Port the API server listens on
PORT=5000

# MongoDB connection string
#   Local MongoDB Community Server:
MONGODB_URI=mongodb+srv://tasnimbushra28_db_user:Wanee1228@cluster0.gweyt43.mongodb.net/?appName=Cluster0
#   MongoDB Atlas (cloud) example — paste your own string from Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cyberquest

# Secret key for the admin dashboard (http://localhost:5173/admin)
# Use something long that only you know.
ADMIN_KEY=Mikoiscute

# Only needed if the React client is hosted on a different domain
# CLIENT_ORIGIN=http://localhost:5173
